# WHM server
WHM_SERVER=your-server-domain.com
WHM_PORT=2087
WHM_USERNAME=root
WHM_API_TOKEN=your_whm_api_token_here
# Only for a WHM server reached by IP or with a self-signed certificate:
# WHM_INSECURE_TLS=true

# Server configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Authentication (required): generate with `openssl rand -hex 32`
API_KEY=your_secure_api_key_here
